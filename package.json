{
  "name": "ts-jobspy",
  "version": "3.0.0",
  "description": "TypeScript job scraper for Indeed, LinkedIn and more - honest per-site results, strict validation, cross-site dedupe",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "biome check src test",
    "lint:fix": "biome check --write src test",
    "test": "jest",
    "test:integration": "jest test/_custom/integration --testPathIgnorePatterns=/node_modules/ --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build",
    "format": "biome format --write src test"
  },
  "keywords": [
    "jobs-scraper",
    "linkedin",
    "indeed",
    "glassdoor",
    "ziprecruiter",
    "google",
    "bayt",
    "naukri",
    "bdjobs",
    "job-search",
    "web-scraping",
    "typescript"
  ],
  "author": "Alpha Romer Coma <alpharomercoma@proton.me>",
  "contributors": [
    "Cullen Watson <cullen@cullenwatson.com>",
    "Zachary Hampton <zachary@zacharysproducts.com>"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alpharomercoma/ts-jobspy.git"
  },
  "bugs": {
    "url": "https://github.com/alpharomercoma/ts-jobspy/issues"
  },
  "homepage": "https://github.com/alpharomercoma/ts-jobspy#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "axios-retry": "^4.0.0",
    "cheerio": "^1.2.0",
    "https-proxy-agent": "^7.0.4",
    "socks-proxy-agent": "^8.0.2",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.16",
    "@types/turndown": "^5.0.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  }
}
